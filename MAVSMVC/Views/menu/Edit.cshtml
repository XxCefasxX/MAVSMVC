@model MenuEditViewModel

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Menu.ID" />

    <label>Nombre</label>
    <input asp-for="Menu.Name" class="form-control" />

    <label>Título</label>
    <input asp-for="Menu.Title" class="form-control" />

    <label>Slug</label>
    <input asp-for="Menu.Slug" class="form-control" />

    <label>Descripción</label>
    <textarea asp-for="Menu.Description" class="form-control"></textarea>

    <label>Contenido</label>
    <textarea asp-for="Content.Info" class="form-control" id="tinymce-editor"></textarea>

    <button type="submit" class="btn btn-primary mt-3">Guardar</button>
</form>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js"></script>
    <script>
        tinymce.init({
            selector: '#tinymce-editor',
            height: 400
        });
    </script>
}
